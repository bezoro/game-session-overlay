    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>../../src/ApolloOverlay/app.manifest</ApplicationManifest>
    <StartupObject>Bezoro.NativeProof.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile
      Include="../../src/ApolloOverlay/Input/PadFrame.cs"
      Link="Shared/PadFrame.cs" />
    <Compile
      Include="../../src/ApolloOverlay/Input/PadInterpreter.cs"
      Link="Shared/PadInterpreter.cs" />
    <Compile
      Include="../../src/ApolloOverlay/Domain/DisplayRef.cs"
      Link="Shared/DisplayRef.cs" />
    <Compile
      Include="../../src/ApolloOverlay/Windows/Native.cs"
      Link="Shared/Native.cs" />
    <Compile
      Include="../../src/ApolloOverlay/UI/Navigation.cs"
      Link="Shared/Navigation.cs" />
    <Compile
      Include="../../src/ApolloOverlay/Input/GuideInput.cs"
      Link="Shared/GuideInput.cs" />
  </ItemGroup>
</Project>
