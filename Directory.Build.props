<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>14</LangVersion>
    <OverlayVersion
      Condition="'$(OverlayVersion)' == ''">$(OVERLAY_VERSION)</OverlayVersion>
    <OverlayVersion
      Condition="'$(OverlayVersion)' == ''">0.2.0-dev+local</OverlayVersion>
    <OverlayBuildId
      Condition="'$(OverlayBuildId)' == ''">$(OVERLAY_BUILD_ID)</OverlayBuildId>
    <OverlayBuildId
      Condition="'$(OverlayBuildId)' == ''">local</OverlayBuildId>
    <OverlayCommit
      Condition="'$(OverlayCommit)' == ''">$(OVERLAY_COMMIT)</OverlayCommit>
    <OverlayCommit
      Condition="'$(OverlayCommit)' == ''">unknown</OverlayCommit>
    <OverlayChannel
      Condition="'$(OverlayChannel)' == ''">$(OVERLAY_CHANNEL)</OverlayChannel>
    <OverlayChannel
      Condition="'$(OverlayChannel)' == ''">testing</OverlayChannel>
    <Version>$(OverlayVersion)</Version>
    <InformationalVersion>$(OverlayVersion)</InformationalVersion>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <OverlayFileVersion
      Condition="'$(OverlayFileVersion)' == ''">$(OVERLAY_FILE_VERSION)</OverlayFileVersion>
    <FileVersion
      Condition="'$(OverlayFileVersion)' != ''">$(OverlayFileVersion)</FileVersion>
    <FileVersion
      Condition="'$(OverlayFileVersion)' == ''">0.2.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata
      Include="OverlayBuildId"
      Value="$(OverlayBuildId)" />
    <AssemblyMetadata
      Include="OverlayCommit"
      Value="$(OverlayCommit)" />
    <AssemblyMetadata
      Include="OverlayChannel"
      Value="$(OverlayChannel)" />
  </ItemGroup>
</Project>
