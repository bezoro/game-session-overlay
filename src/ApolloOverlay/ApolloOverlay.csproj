<Project
  Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/overlay-controller.ico</ApplicationIcon>
    <StartupObject>ApolloOverlay.Program</StartupObject>
  </PropertyGroup>
  <Target
    Name="RemoveFormsGlobalUsings"
    BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using
        Remove="System.Drawing" />
      <Using
        Remove="System.Windows.Forms" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference
      Include="Serilog"
      Version="4.4.0" />
    <PackageReference
      Include="Serilog.Formatting.Compact"
      Version="3.0.0" />
    <PackageReference
      Include="Serilog.Sinks.Async"
      Version="2.1.0" />
    <PackageReference
      Include="Serilog.Sinks.File"
      Version="7.0.0" />
    <PackageReference
      Include="Velopack"
      Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <Resource
      Include="Assets/overlay-controller.ico" />
    <None
      Update="Assets/overlay-controller.ico;Assets/overlay-controller.svg;Assets/overlay-provenance.json"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption
      Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop"
      Value="true" />
  </ItemGroup>
  <ItemGroup>
    <None
      Update="Assets/Icons/*.svg;Assets/Icons/*.txt;Assets/Icons/*.json"
      CopyToPublishDirectory="PreserveNewest" />
    <None
      Update="Assets/ThirdParty/Logging/*.txt;Assets/ThirdParty/Logging/*.json"
      CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
