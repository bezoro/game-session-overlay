<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:ApolloOverlay"
  x:Class="ApolloOverlay.MainWindow"
  Title="Game Session Overlay"
  Language="en-US"
  Width="572"
  Height="940"
  FontFamily="Segoe UI Variable Text, Segoe UI"
  FontSize="16"
  TextOptions.TextFormattingMode="Display"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  WindowStyle="None"
  AllowsTransparency="True"
  Background="Transparent"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  Topmost="True"
  UseLayoutRounding="True"
  SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
          Source="Assets/Icons/Icons.xaml" />
        <ResourceDictionary
          Source="Assets/Icons/InputGlyphs.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style
        TargetType="Image">
        <Setter
          Property="RenderOptions.BitmapScalingMode"
          Value="HighQuality" />
      </Style>
      <Style
        TargetType="Button">
        <Setter
          Property="FontFamily"
          Value="Segoe UI Variable Text, Segoe UI" />
        <Setter
          Property="Foreground"
          Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter
          Property="Background"
          Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter
          Property="BorderBrush"
          Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter
          Property="BorderThickness"
          Value="1" />
        <Setter
          Property="Padding"
          Value="16,12" />
        <Setter
          Property="Margin"
          Value="0,4" />
        <Setter
          Property="MinHeight"
          Value="48" />
        <Setter
          Property="FontSize"
          Value="16" />
        <Setter
          Property="HorizontalContentAlignment"
          Value="Stretch" />
        <Setter
          Property="FocusVisualStyle"
          Value="{x:Null}" />
        <Setter
          Property="Template">
          <Setter.Value>
            <ControlTemplate
              TargetType="Button">
              <Grid
                x:Name="ButtonSurface"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform />
                </Grid.RenderTransform>
                <Border
                  x:Name="SurfaceBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
                  <ContentPresenter
                    TextElement.FontFamily="{TemplateBinding FontFamily}"
                    TextElement.FontSize="{TemplateBinding FontSize}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Border>
                <Border
                  x:Name="SelectionBreath"
                  Margin="2"
                  BorderBrush="{DynamicResource SessionFocusBrush}"
                  BorderThickness="2"
                  CornerRadius="11"
                  IsHitTestVisible="False"
                  Opacity="0" />
                <Border
                  x:Name="SelectionSheen"
                  CornerRadius="10"
                  IsHitTestVisible="False"
                  Opacity="0">
                  <Border.Background>
                    <LinearGradientBrush
                      StartPoint="0,0"
                      EndPoint="1,0">
                      <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform
                          X="-1.4" />
                      </LinearGradientBrush.RelativeTransform>
                      <GradientStop
                        Color="#00FFFFFF"
                        Offset="0" />
                      <GradientStop
                        Color="#00FFFFFF"
                        Offset="0.3" />
                      <GradientStop
                        Color="#12FFFFFF"
                        Offset="0.5" />
                      <GradientStop
                        Color="#00FFFFFF"
                        Offset="0.7" />
                      <GradientStop
                        Color="#00FFFFFF"
                        Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Border
                  x:Name="Interaction"
                  CornerRadius="10"
                  IsHitTestVisible="False"
                  Background="{DynamicResource TextFillColorPrimaryBrush}"
                  Opacity="0" />
                <Border
                  x:Name="ActivationFeedback"
                  CornerRadius="10"
                  IsHitTestVisible="False"
                  Background="{DynamicResource TextFillColorPrimaryBrush}"
                  Opacity="0" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger
                  Property="local:InteractionMotion.IsSelected"
                  Value="True">
                  <Setter
                    TargetName="SurfaceBorder"
                    Property="BorderBrush"
                    Value="Transparent" />
                  <Trigger.EnterActions>
                    <BeginStoryboard
                      Name="SelectionMotion">
                      <Storyboard>
                        <DoubleAnimation
                          Storyboard.TargetName="SelectionBreath"
                          Storyboard.TargetProperty="Opacity"
                          From="0.65"
                          To="1"
                          Duration="0:0:1.5"
                          AutoReverse="True"
                          RepeatBehavior="Forever" />
                        <DoubleAnimation
                          Storyboard.TargetName="ButtonSurface"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                          From="1"
                          To="1.008"
                          Duration="0:0:1.5"
                          AutoReverse="True"
                          RepeatBehavior="Forever">
                          <DoubleAnimation.EasingFunction>
                            <SineEase
                              EasingMode="EaseInOut" />
                          </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                          Storyboard.TargetName="ButtonSurface"
                          Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                          From="1"
                          To="1.008"
                          Duration="0:0:1.5"
                          AutoReverse="True"
                          RepeatBehavior="Forever">
                          <DoubleAnimation.EasingFunction>
                            <SineEase
                              EasingMode="EaseInOut" />
                          </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                          Storyboard.TargetName="SelectionSheen"
                          Storyboard.TargetProperty="Opacity"
                          To="1"
                          Duration="0:0:0.25" />
                        <DoubleAnimationUsingKeyFrames
                          Storyboard.TargetName="SelectionSheen"
                          Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)"
                          Duration="0:0:5"
                          RepeatBehavior="Forever">
                          <LinearDoubleKeyFrame
                            KeyTime="0:0:0"
                            Value="-1.4" />
                          <LinearDoubleKeyFrame
                            KeyTime="0:0:0.5"
                            Value="-1.4" />
                          <EasingDoubleKeyFrame
                            KeyTime="0:0:2.4"
                            Value="1.4">
                            <EasingDoubleKeyFrame.EasingFunction>
                              <SineEase
                                EasingMode="EaseInOut" />
                            </EasingDoubleKeyFrame.EasingFunction>
                          </EasingDoubleKeyFrame>
                          <DiscreteDoubleKeyFrame
                            KeyTime="0:0:5"
                            Value="1.4" />
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <RemoveStoryboard
                      BeginStoryboardName="SelectionMotion" />
                  </Trigger.ExitActions>
                </Trigger>
                <Trigger
                  Property="IsMouseOver"
                  Value="True">
                  <Setter
                    TargetName="Interaction"
                    Property="Opacity"
                    Value="0.06" />
                </Trigger>
                <Trigger
                  Property="IsPressed"
                  Value="True">
                  <Setter
                    TargetName="Interaction"
                    Property="Opacity"
                    Value="0.13" />
                </Trigger>
                <Trigger
                  Property="IsKeyboardFocusWithin"
                  Value="True">
                  <Setter
                    TargetName="SurfaceBorder"
                    Property="BorderBrush"
                    Value="Transparent" />
                  <Setter
                    TargetName="SelectionBreath"
                    Property="Opacity"
                    Value="1" />
                </Trigger>
                <Trigger
                  Property="IsEnabled"
                  Value="False">
                  <Setter
                    Property="Foreground"
                    Value="{DynamicResource TextFillColorDisabledBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style
        x:Key="TabButton"
        TargetType="Button"
        BasedOn="{StaticResource {x:Type Button}}">
        <Setter
          Property="Background"
          Value="Transparent" />
        <Setter
          Property="BorderThickness"
          Value="0" />
        <Setter
          Property="Padding"
          Value="4,10" />
        <Setter
          Property="Margin"
          Value="2,0" />
        <Setter
          Property="MinHeight"
          Value="44" />
        <Setter
          Property="FontSize"
          Value="14" />
        <Setter
          Property="HorizontalContentAlignment"
          Value="Center" />
      </Style>
      <Style
        x:Key="VolumeTrackButton"
        TargetType="RepeatButton">
        <Setter
          Property="Focusable"
          Value="False" />
        <Setter
          Property="Template">
          <Setter.Value>
            <ControlTemplate
              TargetType="RepeatButton">
              <Border
                Height="4"
                Background="{TemplateBinding Background}"
                CornerRadius="2" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style
        x:Key="SessionVolumeSlider"
        TargetType="Slider">
        <Setter
          Property="Foreground"
          Value="{DynamicResource SessionFocusBrush}" />
        <Setter
          Property="Background"
          Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter
          Property="FocusVisualStyle"
          Value="{x:Null}" />
        <Setter
          Property="Height"
          Value="32" />
        <Setter
          Property="Template">
          <Setter.Value>
            <ControlTemplate
              TargetType="Slider">
              <Grid
                Margin="0,2">
                <Border
                  x:Name="SliderFocus"
                  BorderBrush="{DynamicResource SessionFocusBrush}"
                  BorderThickness="1"
                  CornerRadius="5"
                  Margin="-5,0"
                  Visibility="Collapsed" />
                <Track
                  x:Name="PART_Track"
                  Minimum="{TemplateBinding Minimum}"
                  Maximum="{TemplateBinding Maximum}"
                  Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                  IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton
                      Style="{StaticResource VolumeTrackButton}"
                      Background="{TemplateBinding Foreground}"
                      Command="{x:Static Slider.DecreaseLarge}" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton
                      Style="{StaticResource VolumeTrackButton}"
                      Background="{TemplateBinding Background}"
                      Command="{x:Static Slider.IncreaseLarge}" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb
                      Width="22"
                      Height="22">
                      <Thumb.Template>
                        <ControlTemplate
                          TargetType="Thumb">
                          <Border
                            Background="{DynamicResource TextFillColorPrimaryBrush}"
                            BorderBrush="{DynamicResource SessionFocusBrush}"
                            BorderThickness="4"
                            CornerRadius="11" />
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger
                  Property="IsKeyboardFocused"
                  Value="True">
                  <Setter
                    TargetName="SliderFocus"
                    Property="Visibility"
                    Value="Visible" />
                </Trigger>
                <Trigger
                  Property="IsEnabled"
                  Value="False">
                  <Setter
                    Property="Opacity"
                    Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid
    Margin="12">
    <Border
      x:Name="GlassSurface"
      CornerRadius="18"
      Background="{DynamicResource ApplicationBackgroundBrush}" />
    <Border
      x:Name="Sidebar"
      CornerRadius="18"
      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
      BorderThickness="1"
      Padding="24,22">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="*" />
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
          x:Name="HeaderArea"
          Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition
              Width="44" />
          </Grid.ColumnDefinitions>
          <Button
            x:Name="BackButton"
            Visibility="Collapsed"
            Width="44"
            Height="44"
            VerticalAlignment="Center"
            MinHeight="44"
            Padding="10"
            Margin="0,0,12,0"
            AutomationProperties.Name="Back to the previous page">
            <local:VectorIcon
              Data="{StaticResource Icon.back}"
              Fill="{DynamicResource SessionIconNavigationBrush}"
              Width="20"
              Height="20" />
          </Button>
          <StackPanel
            Grid.Column="1">
            <Grid
              x:Name="HeaderIdentityRow"
              Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition
                  Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                x:Name="HeaderBrand"
                Text="Game Session Overlay"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center" />
              <Border
                x:Name="HeaderIdentityBadge"
                Grid.Column="1"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="5"
                Padding="6,3">
                <TextBlock
                  x:Name="HeaderIdentity"
                  Text="v0.2"
                  FontSize="12"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Border>
            </Grid>
            <TextBlock
              x:Name="PageTitle"
              Text="Your session"
              FontFamily="Segoe UI Variable Display, Segoe UI"
              FontSize="25"
              FontWeight="SemiBold"
              TextTrimming="CharacterEllipsis" />
            <TextBlock
              x:Name="ControllerStatusLabel"
              Visibility="Collapsed"
              FontSize="14"
              Margin="0,5,0,0"
              TextTrimming="CharacterEllipsis"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <DockPanel
              x:Name="ControllerInfoBar"
              LastChildFill="True"
              MaxWidth="280"
              HorizontalAlignment="Left"
              Margin="0,5,0,0"
              Visibility="Collapsed"
              AutomationProperties.LiveSetting="Polite">
              <local:VectorIcon
                DockPanel.Dock="Left"
                x:Name="ControllerModelIcon"
                Width="23"
                Height="20"
                Margin="0,0,7,0"
                Fill="{DynamicResource TextFillColorSecondaryBrush}" />
              <StackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Margin="12,0,0,0">
                <Grid
                  x:Name="ControllerBatteryMeter"
                  Width="22"
                  Height="13"
                  Margin="0,0,4,0"
                  VerticalAlignment="Center">
                  <Border
                    Width="18"
                    Height="11"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                    CornerRadius="2"
                    HorizontalAlignment="Left">
                    <Border
                      x:Name="BatteryFill"
                      Height="5"
                      Width="0"
                      Margin="1"
                      HorizontalAlignment="Left"
                      CornerRadius="1"
                      Background="{DynamicResource TextFillColorSecondaryBrush}" />
                  </Border>
                  <Border
                    Width="2"
                    Height="5"
                    CornerRadius="1"
                    Background="{DynamicResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Right" />
                </Grid>
                <TextBlock
                  x:Name="ControllerBatteryLabel"
                  FontSize="12"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  VerticalAlignment="Center" />
                <local:VectorIcon
                  x:Name="ControllerPowerGlyph"
                  Width="14"
                  Height="16"
                  VerticalAlignment="Center"
                  Margin="3,0,0,0"
                  Visibility="Collapsed"
                  Fill="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <TextBlock
                x:Name="ControllerModelLabel"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </StackPanel>
          <Button
            x:Name="SettingsGear"
            Tag="settings"
            Height="44"
            Width="44"
            VerticalAlignment="Center"
            Grid.Column="2"
            Background="Transparent"
            BorderThickness="0"
            Padding="8"
            Margin="0"
            MinHeight="44"
            AutomationProperties.Name="Open System"
            AutomationProperties.HelpText="Open system settings and integrations">
            <local:VectorIcon
              Data="{StaticResource Icon.settings}"
              Fill="{DynamicResource SessionIconToolsBrush}"
              Width="22"
              Height="22" />
          </Button>
        </Grid>
        <Border
          x:Name="TabArea"
          Grid.Row="1"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="10"
          Padding="3"
          Margin="0,0,0,16">
          <UniformGrid
            Columns="3">
            <Button
              x:Name="HomeTab"
              Style="{StaticResource TabButton}">
              <TextBlock
                Text="Session"
                Style="{x:Null}"
                FontFamily="Segoe UI Variable Text, Segoe UI"
                FontSize="16"
                FontWeight="Medium"
                FontStyle="Normal" />
            </Button>
            <Button
              x:Name="AppsTab"
              Style="{StaticResource TabButton}">
              <TextBlock
                Text="Apps"
                Style="{x:Null}"
                FontFamily="Segoe UI Variable Text, Segoe UI"
                FontSize="16"
                FontWeight="Medium"
                FontStyle="Normal" />
            </Button>
            <Button
              x:Name="SettingsTab"
              Style="{StaticResource TabButton}">
              <TextBlock
                Text="Audio"
                Style="{x:Null}"
                FontFamily="Segoe UI Variable Text, Segoe UI"
                FontSize="16"
                FontWeight="Medium"
                FontStyle="Normal" />
            </Button>
          </UniformGrid>
        </Border>
        <ScrollViewer
          x:Name="ContentScroll"
          Grid.Row="2"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled"
          PanningMode="VerticalOnly"
          CanContentScroll="False">
          <StackPanel
            x:Name="ContentStack"
            Margin="0,0,10,0">
            <Border
              x:Name="ContextCard"
              FocusVisualStyle="{x:Null}"
              Margin="0,0,0,14"
              CornerRadius="18"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1">
              <Grid>
                <Border
                  Width="3"
                  Margin="0,18,0,18"
                  HorizontalAlignment="Left"
                  CornerRadius="2"
                  Background="{DynamicResource SessionAccentBrush}"
                  IsHitTestVisible="False"
                  Panel.ZIndex="1" />
                <Button
                  x:Name="SessionCardButton"
                  Margin="0"
                  Padding="16,18"
                  Background="Transparent"
                  BorderThickness="0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition
                        Height="Auto" />
                      <RowDefinition
                        Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition
                        x:Name="SessionIconColumn"
                        Width="66" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border
                      x:Name="SessionArtwork"
                      Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Height="116"
                      CornerRadius="10"
                      Margin="0,0,0,12"
                      Visibility="Collapsed"
                      IsHitTestVisible="False" />
                    <Border
                      x:Name="SessionIconHost"
                      Grid.Row="1"
                      Background="{DynamicResource ControlFillColorDefaultBrush}"
                      CornerRadius="10"
                      Margin="0,0,12,0"
                      Height="54">
                      <Grid>
                        <local:VectorIcon
                          x:Name="ContextGlyph"
                          Data="{StaticResource Icon.window}"
                          Fill="{DynamicResource SessionIconGameBrush}"
                          Width="25"
                          Height="25" />
                        <Image
                          x:Name="ContextIcon"
                          Width="42"
                          Height="42"
                          Visibility="Collapsed" />
                      </Grid>
                    </Border>
                    <StackPanel
                      Grid.Column="1"
                      Grid.Row="1">
                      <TextBlock
                        x:Name="SessionKicker"
                        Text="Session window"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock
                        x:Name="TargetLabel"
                        Text="Choose a window"
                        FontSize="28"
                        TextWrapping="NoWrap"
                        MaxHeight="40"
                        FontWeight="SemiBold"
                        Margin="0,2,0,4"
                        TextTrimming="CharacterEllipsis" />
                      <WrapPanel>
                        <TextBlock
                          x:Name="SessionEvidence"
                          Text="Windows"
                          FontSize="14"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Ellipse
                          x:Name="ContextStatusDot"
                          Width="7"
                          Height="7"
                          Fill="{DynamicResource SystemFillColorSuccessBrush}"
                          Margin="10,0,6,0" />
                        <TextBlock
                          x:Name="ContextStatus"
                          Text="Available"
                          FontSize="14"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </WrapPanel>
                      <TextBlock
                        x:Name="SessionAudioLabel"
                        Visibility="Collapsed"
                        FontSize="14"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock
                        x:Name="SessionHint"
                        Text="Enter · Resume   X · Options"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        FontSize="14"
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </Grid>
            </Border>
            <Grid
              x:Name="Rows" />
          </StackPanel>
        </ScrollViewer>
        <local:VectorIcon
          x:Name="ScrollContinuation"
          IsHitTestVisible="False"
          Grid.Row="2"
          Width="14"
          Height="14"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Margin="0,0,0,3"
          Visibility="Hidden"
          Data="{StaticResource Icon.back}"
          Fill="{DynamicResource TextFillColorSecondaryBrush}"
          RenderTransformOrigin="0.5,0.5"
          AutomationProperties.Name="More controls below">
          <local:VectorIcon.RenderTransform>
            <RotateTransform
              Angle="-90" />
          </local:VectorIcon.RenderTransform>
        </local:VectorIcon>
        <Border
          x:Name="ConfirmPanel"
          Grid.Row="2"
          Grid.RowSpan="2"
          Visibility="Collapsed"
          Background="{DynamicResource ApplicationBackgroundBrush}"
          CornerRadius="16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition
                Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
              x:Name="ConfirmScroll"
              VerticalScrollBarVisibility="Auto">
              <StackPanel
                x:Name="ConfirmationInfo"
                Margin="4,6">
                <TextBlock
                  Text="Safe closing"
                  Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                  FontSize="13"
                  FontWeight="SemiBold" />
                <TextBlock
                  Text="Close this window?"
                  FontSize="24"
                  FontWeight="SemiBold"
                  TextWrapping="Wrap"
                  Margin="0,8,0,0" />
                <TextBlock
                  x:Name="ConfirmTarget"
                  FontSize="18"
                  TextWrapping="Wrap"
                  Margin="0,8,0,8" />
                <TextBlock
                  x:Name="ConfirmationWarning"
                  Text="Unsaved work may be lost."
                  FontSize="15"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </ScrollViewer>
            <StackPanel
              Grid.Row="1"
              Margin="0,8,0,0">
              <ProgressBar
                x:Name="HoldProgress"
                Height="6"
                Maximum="1"
                Margin="0,0,0,8"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
              <TextBlock
                x:Name="ConfirmHint"
                Text="Waiting for release…"
                FontSize="13"
                Margin="0,0,0,4"
                TextWrapping="Wrap" />
              <Button
                x:Name="HoldCloseButton"
                MinHeight="52"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                AutomationProperties.Name="Hold for 1.5 seconds to close this window">
                <TextBlock
                  Text="Hold to close · 1.5 s"
                  TextWrapping="Wrap"
                  TextAlignment="Center" />
              </Button>
              <Button
                x:Name="CancelCloseButton"
                Content="Cancel"
                MinHeight="44"
                AutomationProperties.Name="Cancel closing" />
            </StackPanel>
          </Grid>
        </Border>
        <Border
          x:Name="OperationPanel"
          Grid.Row="4"
          Visibility="Hidden"
          Background="Transparent"
          Height="44"
          Margin="0,4,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="22" />
              <ColumnDefinition />
              <ColumnDefinition
                Width="Auto" />
              <ColumnDefinition
                Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="OperationGlyph"
              FontFamily="Segoe UI Variable Text, Segoe UI"
              FontWeight="Bold"
              FontSize="16"
              VerticalAlignment="Center" />
            <TextBlock
              x:Name="OperationLabel"
              Grid.Column="1"
              FontSize="14"
              TextWrapping="NoWrap"
              TextTrimming="CharacterEllipsis"
              LineHeight="17"
              LineStackingStrategy="BlockLineHeight"
              MaxHeight="34"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              AutomationProperties.LiveSetting="Polite" />
            <Button
              x:Name="OperationDetailsButton"
              Grid.Column="2"
              Width="76"
              Height="40"
              MinHeight="40"
              FontSize="13"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Padding="4"
              Margin="4,0,0,0"
              Background="Transparent"
              BorderThickness="0"
              ToolTip="Read full result"
              AutomationProperties.Name="Read full result" />
            <Button
              x:Name="DismissOperationButton"
              Grid.Column="3"
              Width="40"
              Height="40"
              MinHeight="40"
              Padding="4"
              Margin="4,0,0,0"
              Background="Transparent"
              BorderThickness="0"
              AutomationProperties.Name="Dismiss command result">
              <local:VectorIcon
                Data="{StaticResource Icon.close}"
                Width="16"
                Height="16"
                Fill="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
          </Grid>
        </Border>
        <Border
          x:Name="DirtyStrip"
          Grid.Row="5"
          Visibility="Collapsed"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource SessionAccentBrush}"
          BorderThickness="1,0,0,0"
          Padding="12,8"
          Margin="0,12,0,0">
          <StackPanel>
            <TextBlock
              x:Name="DirtyLabel"
              Text="Unsaved changes"
              FontSize="14"
              FontWeight="SemiBold" />
            <UniformGrid
              Columns="2"
              Margin="0,4,0,0">
              <Button
                x:Name="SaveSettingsButton"
                Content="Save"
                MinHeight="40"
                Padding="8,4"
                Margin="0,0,4,0" />
              <Button
                x:Name="DiscardSettingsButton"
                Content="Discard"
                MinHeight="40"
                Padding="8,4"
                Margin="4,0,0,0" />
            </UniformGrid>
          </StackPanel>
        </Border>
        <StackPanel
          x:Name="FooterArea"
          Grid.Row="6"
          Margin="0,10,0,0">
          <Border
            x:Name="FooterDivider"
            Height="1"
            Margin="0,0,0,8"
            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
          <TextBlock
            x:Name="SharedControlNotice"
            Text="Controller input may also reach the game."
            FontSize="14"
            FontWeight="SemiBold"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            AutomationProperties.Name="Controller input may also reach the game while this panel is open." />
          <TextBlock
            x:Name="StatusLabel"
            Visibility="Collapsed"
            FontSize="14"
            Margin="0,4,0,0"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock
            x:Name="ModeLabel"
            FontSize="14"
            LineHeight="19"
            Margin="0,5,0,0"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
