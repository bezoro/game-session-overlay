<Window x:Class="ApolloOverlay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bezoro · Controle da sessão" Width="572" Height="940" FontFamily="Segoe UI" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Assets/Icons/Icons.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,3"/><Setter Property="MinHeight" Value="62"/><Setter Property="FontSize" Value="22"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><Border CornerRadius="12" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0EFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.7"/></LinearGradientBrush></Border.Background></Border></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TabButton" TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="17"/><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="4" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></Window.Resources>
 <Grid Margin="18">
  <Border x:Name="GlassSurface" CornerRadius="24" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.93"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5"/></Border.Effect></Border>
  <Border x:Name="Sidebar" CornerRadius="24" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="22,18">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
     <Path Data="{StaticResource Icon.controller}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center"/>
     <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Controle da sessão" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Button x:Name="SettingsGear" Grid.Column="2" FontSize="25" Background="Transparent" BorderThickness="0" Padding="2" MinHeight="40" Margin="0" ToolTip="Abrir Sistema" AutomationProperties.Name="Abrir Sistema" AutomationProperties.HelpText="Abrir ajustes do sistema e integrações"><Path Data="{StaticResource Icon.settings}" Fill="{DynamicResource TextFillColorPrimaryBrush}" Width="25" Height="25" Stretch="Uniform"/></Button>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="5" Height="24" VerticalAlignment="Center"><TextBlock Text="LB" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Button x:Name="HomeTab" Style="{StaticResource TabButton}" Grid.Column="1" Content="Sessão" FontSize="17" Padding="4" MinHeight="40" Background="Transparent" BorderThickness="0"/><Button x:Name="AppsTab" Style="{StaticResource TabButton}" Grid.Column="2" Content="Aplicativos" FontSize="17" Padding="4" MinHeight="40" Background="Transparent" BorderThickness="0"/><Button x:Name="SettingsTab" Style="{StaticResource TabButton}" Grid.Column="3" Content="Sistema" FontSize="17" Padding="4" MinHeight="40" Background="Transparent" BorderThickness="0"/><Border Grid.Column="4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="5" Height="24" VerticalAlignment="Center"><TextBlock Text="RB" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
    <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False"><StackPanel>
     <Border x:Name="ContextCard" Height="119" Margin="0,0,0,12" Padding="15" CornerRadius="13" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="9" Margin="0,0,16,0"><Grid><TextBlock x:Name="ContextGlyph" Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="39" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ContextIcon" Width="48" Height="48" Visibility="Collapsed"/></Grid></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="TargetLabel" Text="Nenhuma janela selecionada" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><WrapPanel Margin="0,8,0,0"><Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="7" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="7,3" Margin="0,0,10,0"><TextBlock x:Name="SessionEvidence" Text="Janela" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></Border><Ellipse x:Name="ContextStatusDot" Width="9" Height="9" Fill="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock x:Name="ContextStatus" Text="Disponível" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></WrapPanel></StackPanel>
     </Grid></Border>
     <Grid x:Name="Rows"/>
    </StackPanel></ScrollViewer>
    <Grid x:Name="CloseArea" Grid.Row="3" Margin="0,12,0,4"/>
    <Border x:Name="ConfirmPanel" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="16" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="Fechar esta janela?" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ConfirmTarget" FontSize="22" TextWrapping="Wrap" Margin="0,22"/><TextBlock Text="Pode haver trabalho não salvo. Solte e pressione novamente A / Enter / Espaço por 1,5 segundo." FontSize="20" TextWrapping="Wrap"/><ProgressBar x:Name="HoldProgress" Height="9" Maximum="1" Margin="0,28,0,18" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/><TextBlock x:Name="ConfirmHint" Text="Aguardando soltar…" FontSize="18" TextWrapping="Wrap"/><TextBlock Text="B / Esc · Cancelar" FontSize="18" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,26,0,0"/></StackPanel></ScrollViewer></Border>
    <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="StatusLabel" Text="Pronto" FontSize="14" LineHeight="19" TextWrapping="Wrap" MaxHeight="76" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><WrapPanel Margin="0,10,0,0"><Border Width="23" Height="23" CornerRadius="12" Margin="0,0,5,0" Background="{DynamicResource SystemFillColorSuccessBrush}"><TextBlock Text="A" Foreground="{DynamicResource ApplicationBackgroundBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Enter / Espaço · Selecionar   " FontSize="15"/><Border Width="23" Height="23" CornerRadius="12" Margin="0,0,5,0" Background="{DynamicResource SystemFillColorCriticalBrush}"><TextBlock Text="B" Foreground="{DynamicResource ApplicationBackgroundBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Esc · Voltar   " FontSize="15"/><TextBlock Text="● X " Foreground="#FF68A9FF" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Detalhes" FontSize="15"/></WrapPanel><TextBlock x:Name="ModeLabel" Text="LB/RB / PgUp/PgDn · Abas · Setas / Tab · Mover" FontSize="12" Margin="0,7,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
