<Window x:Class="ApolloOverlay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Apollo · painel da TV" Width="1280" Height="720" MinWidth="900" MinHeight="540" Background="#10191F" Foreground="#F4F8FA" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F4F8FA"/><Setter Property="Background" Value="#1A2932"/><Setter Property="BorderBrush" Value="#39505E"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="16,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="26"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#77E3B0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Viewbox x:Name="Viewport" Stretch="Uniform">
  <Grid x:Name="CanvasRoot" Width="1280" Height="720" Background="#10191F">
   <Grid.Margin>0</Grid.Margin>
   <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="72"/><RowDefinition Height="48"/><RowDefinition Height="432"/><RowDefinition Height="84"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="48,8,48,4"><StackPanel><TextBlock Text="APOLLO  /  PAINEL DA TV" FontSize="17" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="#84A5B7"/><TextBlock x:Name="PageTitle" Text="Controle da sessão" FontSize="38" LineHeight="44" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#244C3E" CornerRadius="8" Padding="14,7"><TextBlock x:Name="ModeLabel" Text="PRÉVIA SEGURA" FontSize="20" Foreground="#9CF3C6"/></Border></Grid>
   <Border Grid.Row="1" Margin="48,0" Background="#192731" CornerRadius="10" Padding="16,6"><StackPanel><TextBlock x:Name="TargetLabel" FontSize="26" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DisplayLabel" FontSize="19" Foreground="#ACC1CE" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
   <Grid Grid.Row="2" Margin="48,8,48,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="HomeTab" Grid.Column="0" Content="LB   Início" FontSize="22" Padding="12,0" Margin="0,0,8,0"/><Button x:Name="AppsTab" Grid.Column="1" Content="Aplicativos" FontSize="22" Padding="12,0" Margin="0,0,8,0"/><Button x:Name="SettingsTab" Grid.Column="2" Content="Ajustes   RB" FontSize="22" Padding="12,0"/></Grid>
   <StackPanel x:Name="Rows" Grid.Row="3" Margin="48,0"/>
   <StackPanel Grid.Row="4" Margin="48,4,48,0"><TextBlock x:Name="StatusLabel" FontSize="21" LineHeight="25" LineStackingStrategy="BlockLineHeight" Foreground="#A9E7D1" TextWrapping="Wrap" MaxHeight="50"/><TextBlock Text="↑↓ / D-pad mover    A / Enter escolher    B / Esc voltar    X detalhes    LB/RB páginas" FontSize="19" LineHeight="23" LineStackingStrategy="BlockLineHeight" Foreground="#ACC1CE" Margin="0,4,0,0"/></StackPanel>
   <Border x:Name="ConfirmPanel" Grid.RowSpan="5" Visibility="Collapsed" Background="#F510191F" Padding="100,120"><StackPanel><TextBlock Text="Fechar esta janela?" FontSize="38" FontWeight="SemiBold"/><TextBlock x:Name="ConfirmTarget" FontSize="28" TextWrapping="Wrap" MaxHeight="120" Margin="0,24"/><TextBlock Text="Pode haver trabalho não salvo. Solte A / Enter e pressione novamente, mantendo por 1,5 s. B / Esc cancela." FontSize="26" TextWrapping="Wrap"/><ProgressBar x:Name="HoldProgress" Minimum="0" Maximum="1" Height="20" Margin="0,28" Foreground="#77E3B0"/><TextBlock x:Name="ConfirmHint" Text="Aguardando soltar A / Enter…" FontSize="24"/></StackPanel></Border>
  </Grid>
 </Viewbox>
</Window>
