<Window x:Class="ApolloOverlay.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Apollo · controle da sessão" Width="1280" Height="720" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Viewbox x:Name="Viewport" Stretch="Uniform"><Grid x:Name="CanvasRoot" Width="1280" Height="720">
  <Grid x:Name="PreviewBackdrop" ClipToBounds="True">
   <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#111B20" Offset="0"/><GradientStop Color="#715E42" Offset="0.65"/><GradientStop Color="#1C302E" Offset="1"/></LinearGradientBrush></Grid.Background>
   <Ellipse Width="420" Height="420" Fill="#22EACB8C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-110,80,0"/>
   <Path Fill="#303D3C" Opacity="0.8" Data="M 0,510 L 200,360 340,430 580,270 810,405 960,310 1280,480 1280,720 0,720 Z"/>
   <Path Fill="#172726" Data="M 0,620 L 250,500 510,570 800,430 1080,550 1280,470 1280,720 0,720 Z"/>
   <Path Stroke="#66AD9866" StrokeThickness="2" Data="M 570,720 Q 720,600 760,470 M 760,470 L 745,375 M 730,435 L 810,435 M 830,460 L 830,330 875,300 920,330 920,490 M 852,385 L 852,350 M 895,385 L 895,350"/>
   <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,38,0"><TextBlock Text="CENÁRIO ILUSTRATIVO" FontSize="14" Foreground="#D2D8D0" HorizontalAlignment="Right"/><TextBlock Text="Prévia segura · nenhuma imagem do seu jogo" FontSize="13" Foreground="#BAC3BB" HorizontalAlignment="Right"/></StackPanel>

  </Grid>
  <Border x:Name="Sidebar" Width="440" Height="684" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,18,0,0" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="20" Padding="17">
   <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="38"/><RowDefinition Height="84"/><RowDefinition Height="340"/><RowDefinition Height="44"/><RowDefinition Height="98"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Viewbox Width="25" Height="25" HorizontalAlignment="Left"><Grid Width="24" Height="24"><Ellipse Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.8"/><Path Data="M 6,6 L 18,18 M 18,6 L 6,18" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2.5"/></Grid></Viewbox><TextBlock x:Name="PageTitle" Grid.Column="1" Text="Controle da sessão" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="SettingsGear" Grid.Column="2" Content="⚙" Padding="0" FontSize="24" Background="Transparent" BorderThickness="0" ToolTip="Sistema / ajustes"/></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Text="LB" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/><Button x:Name="HomeTab" Grid.Column="1" Content="Sessão" Padding="3,3" FontSize="14" Background="Transparent" BorderThickness="0"/><Button x:Name="AppsTab" Grid.Column="2" Content="Aplicativos" Padding="3,3" FontSize="14" Background="Transparent" BorderThickness="0"/><Button x:Name="SettingsTab" Grid.Column="3" Content="Sistema" Padding="3,3" FontSize="14" Background="Transparent" BorderThickness="0"/><TextBlock Grid.Column="4" Text="RB" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Margin="0,5,0,9" Padding="9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="6" Margin="0,0,10,0"><Viewbox Width="36" Height="26"><Path Stroke="{DynamicResource SystemFillColorSuccessBrush}" StrokeThickness="1.6" Data="M 5,7 Q 12,3 19,7 L 23,18 Q 20,22 16,16 L 8,16 Q 4,22 1,18 Z M 5,10 L 5,15 M 3,12 L 8,12 M 17,10 L 18,10 M 20,13 L 21,13"/></Viewbox></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="TargetLabel" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SessionEvidence" Text="Janela de exemplo · suporte Steam não confirmado" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></Grid></Border>
    <Grid x:Name="Rows" Grid.Row="3"/>
    <Grid x:Name="CloseArea" Grid.Row="4" Margin="0,0,0,4"/>
    <StackPanel Grid.Row="5" Margin="0,5,0,0"><TextBlock x:Name="StatusLabel" FontSize="14" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxHeight="54"/><TextBlock Text="Ⓐ Escolher    Ⓑ Voltar    X Detalhes" FontSize="13" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/><TextBlock x:Name="ModeLabel" Text="LB/RB Abas  ·  Guide desligado na prévia" FontSize="11.5" LineHeight="14" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
    <Border x:Name="ConfirmPanel" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="12" Padding="22"><StackPanel VerticalAlignment="Center"><TextBlock Text="Fechar esta janela?" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ConfirmTarget" FontSize="19" TextWrapping="Wrap" MaxHeight="145" Margin="0,18"/><TextBlock Text="Pode haver trabalho não salvo. Solte A / Enter e pressione novamente por 1,5 s." FontSize="17" TextWrapping="Wrap"/><ProgressBar x:Name="HoldProgress" Minimum="0" Maximum="1" Height="10" Margin="0,24,0,15" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/><TextBlock x:Name="ConfirmHint" Text="Aguardando soltar A / Enter…" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="Ⓑ / Esc  Cancelar" FontSize="16" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,24,0,0"/></StackPanel></Border>
   </Grid>
  </Border>
 </Grid></Viewbox>
</Window>